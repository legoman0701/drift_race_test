        //"burnEfficiency":0.24,
        "cylinderWallTemperatureDamageThreshold":180
        //turbocharger name
        "turbocharger":"turbocharger",
        "instantAfterFireCoef": 20,
        "sustainedAfterFireCoef": 20,
